<section class="cs-dashboard"><header><h2>Relationship Dashboard</h2><button type="button" data-action="refreshBoard">Refresh Player Board</button></header>{{#each pcs}}<section class="cs-pc"><h3>{{name}}</h3><table><thead><tr><th>Historical identity</th><th>Current face</th><th>Type</th><th>Status</th><th>Reveal</th></tr></thead><tbody>{{#each relationships}}<tr><td>{{name}}{{#if plotCritical}} ★{{/if}}</td><td>{{current}}</td><td>{{category}}</td><td>{{state}}</td><td><button type="button" data-action="setReveal" data-uuid="{{uuid}}" data-state="familiar">Familiar</button><button type="button" data-action="setReveal" data-uuid="{{uuid}}" data-state="suspected">Suspected</button><button type="button" data-action="setReveal" data-uuid="{{uuid}}" data-state="confirmed">Confirm</button></td></tr>{{/each}}</tbody></table></section>{{/each}}</section>
